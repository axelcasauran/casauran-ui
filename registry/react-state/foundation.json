{
  "$schema": "../schemas/react-state-foundation.schema.json",
  "schemaVersion": 1,
  "packages": {
    "core": "@casauran-internal/core",
    "reactEntryPoint": "@casauran/react/state"
  },
  "capabilities": [
    {
      "id": "state-resolution",
      "owner": "packages/core",
      "module": "packages/core/src/state.ts",
      "exports": ["isControlledValue", "resolveControllableValue", "resolveStateUpdate"],
      "clientBoundary": false,
      "evidence": ["unit", "typing"]
    },
    {
      "id": "id-normalization",
      "owner": "packages/core",
      "module": "packages/core/src/id.ts",
      "exports": ["normalizeIdPart", "createScopedId"],
      "clientBoundary": false,
      "evidence": ["unit", "ssr", "typing"]
    },
    {
      "id": "committed-callback",
      "owner": "packages/react",
      "module": "packages/react/src/state/use-committed-callback.ts",
      "exports": ["useCommittedCallback"],
      "clientBoundary": true,
      "evidence": ["unit", "hydration", "browser", "typing"]
    },
    {
      "id": "controllable-state",
      "owner": "packages/react",
      "module": "packages/react/src/state/use-controllable-state.ts",
      "exports": ["useControllableState"],
      "clientBoundary": true,
      "evidence": ["unit", "ssr", "hydration", "browser", "typing"]
    },
    {
      "id": "hydration-state",
      "owner": "packages/react",
      "module": "packages/react/src/state/use-hydrated.ts",
      "exports": ["useHydrated", "useStableId"],
      "clientBoundary": true,
      "evidence": ["unit", "ssr", "hydration", "browser", "typing"]
    }
  ],
  "boundaries": {
    "owned": [
      "framework-neutral controlled value and state update resolution",
      "framework-neutral generated ID normalization",
      "latest committed callback invocation with stable identity",
      "controlled and uncontrolled React state coordination",
      "hydration readiness and hydration-stable React IDs"
    ],
    "excluded": [
      "public component implementation",
      "global state stores or context frameworks",
      "collection registration active item selection or typeahead",
      "overlay open state focus lifecycle or dismissal",
      "form validation or field state",
      "persistent or serialized state",
      "component-specific state machines",
      "reference-derived data-binding parity claims"
    ]
  }
}
