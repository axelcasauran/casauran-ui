{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casauran.dev/schemas/theme-contract.schema.json",
  "title": "Casauran theme runtime contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "attributes",
    "cascadeLayers",
    "themes",
    "densities",
    "motion",
    "forcedColors"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": { "const": "@casauran/theme" },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "density"],
      "properties": {
        "theme": { "const": "data-theme" },
        "density": { "const": "data-density" }
      }
    },
    "cascadeLayers": {
      "type": "array",
      "prefixItems": [
        { "const": "reset" },
        { "const": "tokens" },
        { "const": "base" },
        { "const": "components" },
        { "const": "utilities" },
        { "const": "overrides" }
      ],
      "items": false
    },
    "themes": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/theme" }
    },
    "densities": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/density" }
    },
    "motion": { "$ref": "#/$defs/assignments" },
    "forcedColors": { "$ref": "#/$defs/assignments" }
  },
  "$defs": {
    "assignments": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "colorScheme", "assignments"],
      "properties": {
        "name": { "enum": ["light", "dark"] },
        "colorScheme": { "enum": ["light", "dark"] },
        "assignments": { "$ref": "#/$defs/assignments" }
      }
    },
    "density": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "assignments"],
      "properties": {
        "name": { "enum": ["comfortable", "compact"] },
        "assignments": { "$ref": "#/$defs/assignments" }
      }
    }
  }
}
