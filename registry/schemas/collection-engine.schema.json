{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casauran.dev/schemas/collection-engine.schema.json",
  "title": "Casauran collection engine contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "capabilities", "boundaries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": { "const": "@casauran-internal/collections" },
    "capabilities": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/capability" }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned", "excluded"],
      "properties": {
        "owned": { "$ref": "#/$defs/nonEmptyStrings" },
        "excluded": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module", "exports", "evidence"],
      "properties": {
        "id": {
          "enum": [
            "snapshot",
            "registration",
            "active-item",
            "selection",
            "visible-tree",
            "typeahead"
          ]
        },
        "module": { "type": "string", "minLength": 1 },
        "exports": { "$ref": "#/$defs/nonEmptyStrings" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["unit", "ssr", "typing", "security", "large-data"] }
        }
      }
    }
  }
}
