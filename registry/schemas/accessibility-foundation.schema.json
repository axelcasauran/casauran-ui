{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casauran.dev/schemas/accessibility-foundation.schema.json",
  "title": "Casauran accessibility foundation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "package", "baseline", "capabilities", "boundaries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": { "const": "@casauran-internal/accessibility" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wcag", "semanticHtmlFirst", "apgPatternSpecific"],
      "properties": {
        "wcag": { "const": "2.2 AA" },
        "semanticHtmlFirst": { "const": true },
        "apgPatternSpecific": { "const": true }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/capability" }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned", "excluded"],
      "properties": {
        "owned": { "$ref": "#/$defs/nonEmptyStrings" },
        "excluded": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module", "exports", "evidence"],
      "properties": {
        "id": {
          "enum": ["focus", "roving-focus", "keyboard", "live-region", "visually-hidden"]
        },
        "module": { "type": "string", "minLength": 1 },
        "exports": { "$ref": "#/$defs/nonEmptyStrings" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["unit", "browser", "ssr", "accessibility-tree", "security"] }
        }
      }
    }
  }
}
