{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casauran.dev/schemas/token-contract.schema.json",
  "title": "Casauran token contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "cssNamespace",
    "layers",
    "tokenTypes",
    "primitives",
    "semantics",
    "components"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "package": { "const": "@casauran/tokens" },
    "cssNamespace": { "const": "csn" },
    "layers": {
      "type": "array",
      "prefixItems": [
        { "const": "primitive" },
        { "const": "semantic" },
        { "const": "component" },
        { "const": "theme" }
      ],
      "items": false
    },
    "tokenTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tokenType" },
      "uniqueItems": true
    },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/primitive" }
    },
    "semantics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/semantic" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "tokenType": {
      "enum": [
        "color",
        "dimension",
        "font-family",
        "font-size",
        "font-weight",
        "line-height",
        "shadow",
        "duration",
        "easing",
        "number",
        "z-index"
      ]
    },
    "base": {
      "type": "object",
      "required": ["name", "type", "cssVariable", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "type": { "$ref": "#/$defs/tokenType" },
        "cssVariable": { "type": "string", "pattern": "^--csn-[a-z0-9-]+$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "primitive": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type", "value", "cssVariable", "description"],
          "properties": {
            "name": true,
            "type": true,
            "value": { "type": ["string", "number"] },
            "cssVariable": true,
            "description": true
          }
        }
      ]
    },
    "semantic": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type", "reference", "cssVariable", "description"],
          "properties": {
            "name": true,
            "type": true,
            "reference": { "type": "string", "minLength": 1 },
            "cssVariable": true,
            "description": true
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "name", "type", "reference", "cssVariable", "description"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/tokenType" },
        "reference": { "type": "string", "minLength": 1 },
        "cssVariable": { "type": "string", "pattern": "^--csn-[a-z0-9-]+$" },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
