{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casauran.dev/schemas/react-state-foundation.schema.json",
  "title": "Casauran React state foundation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packages", "capabilities", "boundaries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "reactEntryPoint"],
      "properties": {
        "core": { "const": "@casauran-internal/core" },
        "reactEntryPoint": { "const": "@casauran/react/state" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/capability" }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned", "excluded"],
      "properties": {
        "owned": { "$ref": "#/$defs/nonEmptyStrings" },
        "excluded": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "module", "exports", "clientBoundary", "evidence"],
      "properties": {
        "id": {
          "enum": [
            "state-resolution",
            "id-normalization",
            "committed-callback",
            "controllable-state",
            "hydration-state"
          ]
        },
        "owner": { "enum": ["packages/core", "packages/react"] },
        "module": { "type": "string", "minLength": 1 },
        "exports": { "$ref": "#/$defs/nonEmptyStrings" },
        "clientBoundary": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["unit", "ssr", "hydration", "browser", "typing"] }
        }
      }
    }
  }
}
