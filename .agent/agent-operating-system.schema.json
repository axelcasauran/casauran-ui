{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casauran.dev/schemas/agent-operating-system.schema.json",
  "title": "Casauran Agent Operating System contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ownerRoles",
    "authorityContract",
    "catalogs",
    "requiredInputs",
    "executionLifecycle",
    "taskClasses",
    "operations",
    "modifiers",
    "domainRoutes",
    "blockingConditions",
    "stopConditions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "ownerRoles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "authorityContract": { "type": "string", "minLength": 1 },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillsRoot", "workflowsRoot", "promptsRoot"],
      "properties": {
        "skillsRoot": { "type": "string", "minLength": 1 },
        "workflowsRoot": { "type": "string", "minLength": 1 },
        "promptsRoot": { "type": "string", "minLength": 1 }
      }
    },
    "requiredInputs": { "$ref": "#/$defs/nonEmptyStrings" },
    "executionLifecycle": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lifecycleStep" }
    },
    "taskClasses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    },
    "modifiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/route" }
    },
    "domainRoutes": {
      "type": "array",
      "items": { "$ref": "#/$defs/domainRoute" }
    },
    "blockingConditions": { "$ref": "#/$defs/nonEmptyStrings" },
    "stopConditions": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "lifecycleStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirements"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "requirements": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompts", "workflows", "skills"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "prompts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "workflows": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "domainRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skills"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
