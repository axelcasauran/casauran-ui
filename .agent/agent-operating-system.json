{
  "$schema": "agent-operating-system.schema.json",
  "schemaVersion": 1,
  "ownerRoles": ["maintainer", "evidence-reviewer"],
  "authorityContract": ".agent/repository-governance.json",
  "catalogs": {
    "skillsRoot": "skills",
    "workflowsRoot": ".agent/workflows",
    "promptsRoot": ".agent/prompts"
  },
  "requiredInputs": [
    "AGENTS.md",
    ".agent/status.md",
    "active stage ledger",
    "relevant accepted ADRs and policies",
    "routed skills, workflows, and prompts"
  ],
  "executionLifecycle": [
    {
      "id": "preflight",
      "requirements": [
        "inspect repository status",
        "verify prerequisite stages",
        "load authority and active scope"
      ]
    },
    {
      "id": "classify",
      "requirements": ["select one primary task class", "add applicable operations and modifiers"]
    },
    {
      "id": "route",
      "requirements": ["load every required prompt, workflow, and skill before task actions"]
    },
    {
      "id": "acceptance",
      "requirements": ["derive acceptance criteria from repository contracts", "state boundaries"]
    },
    {
      "id": "execute",
      "requirements": ["work at the owning layer", "preserve higher-authority contracts"]
    },
    {
      "id": "validate",
      "requirements": ["run targeted checks", "run the stage-required repository gate"]
    },
    {
      "id": "record",
      "requirements": ["update durable evidence and status only when justified"]
    },
    {
      "id": "stop",
      "requirements": ["stop at the active task or stage boundary", "report COMPLETE or BLOCKED"]
    }
  ],
  "taskClasses": [
