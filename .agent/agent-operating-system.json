  "blockingConditions": [
    "a higher-authority contract conflict is unresolved",
    "the active stage or prerequisite cannot be verified",
    "a required local reference corpus check fails",
    "required authority, approval, credentials, or external state is unavailable",
    "an acceptance gate fails and cannot be repaired within the active scope"
  ],
  "stopConditions": [
    "the active task or stage acceptance criteria are satisfied and evidenced",
    "the task is blocked with the blocking evidence recorded",
    "continuation would enter a later stage or materially expand authorized scope"
  ]
