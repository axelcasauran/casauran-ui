{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casauran.dev/schemas/mechanical-governance.schema.json",
  "title": "Casauran mechanical governance contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ownerRoles",
    "authorityContracts",
    "execution",
    "unitTests",
    "validators",
    "rootGates",
    "ci"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "ownerRoles": { "$ref": "#/$defs/nonEmptyStrings" },
    "authorityContracts": { "$ref": "#/$defs/nonEmptyStrings" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "packageScript", "mode", "network", "failureMode", "supportScripts"],
      "properties": {
        "runner": { "type": "string", "minLength": 1 },
        "packageScript": { "type": "string", "minLength": 1 },
        "mode": { "const": "read-only" },
        "network": { "const": "forbidden" },
        "failureMode": { "const": "collect-and-fail" },
        "supportScripts": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "unitTests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "packageScript"],
      "properties": {
        "script": { "type": "string", "minLength": 1 },
        "packageScript": { "type": "string", "minLength": 1 }
      }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/validator" }
    },
    "rootGates": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/rootGate" }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "requiredCommand"],
      "properties": {
        "workflow": { "type": "string", "minLength": 1 },
        "requiredCommand": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "script", "packageScript", "ownerRoles", "contracts"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "script": { "type": "string", "pattern": "^scripts/validate-[a-z0-9-]+\\.mjs$" },
        "packageScript": { "type": "string", "pattern": "^validate:[a-z0-9-]+$" },
        "ownerRoles": { "$ref": "#/$defs/nonEmptyStrings" },
        "contracts": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "rootGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "packageScript", "requiredFor"],
      "properties": {
        "id": { "enum": ["preinstall", "static", "full"] },
        "packageScript": { "type": "string", "minLength": 1 },
        "requiredFor": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    }
  }
}
