      "roles": ["maintainer", "evidence-reviewer"]
    },
    {
      "pattern": "/scripts/verify-scaffold.mjs",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "evidence-reviewer"]
    },
    {
      "pattern": "/scripts/*build-test*.mjs",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "evidence-reviewer"]
    },
    {
      "pattern": "/scripts/verify-build-output.mjs",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "evidence-reviewer"]
    },
    {
      "pattern": "/tests/**",
      "owners": ["@axelcasauran"],
