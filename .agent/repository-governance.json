    {
      "pattern": "/packages/theme/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner"]
    },
    {
      "pattern": "/packages/accessibility/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/packages/core/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/packages/react/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/packages/collections/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/packages/overlay/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer", "security-reviewer"]
    },
    {
      "pattern": "/scripts/*token*.mjs",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/scripts/*theme*.mjs",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/scripts/*accessibility*.mjs",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/scripts/*react-state*.mjs",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/scripts/*collection*.mjs",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/scripts/*overlay*.mjs",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer", "security-reviewer"]
    },
    {
      "pattern": "/specs/foundation/tokens.md",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/specs/foundation/css-theme-runtime.md",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/specs/foundation/accessibility.md",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/specs/foundation/react-state.md",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/specs/foundation/collection-engine.md",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/specs/foundation/overlay.md",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer", "security-reviewer"]
    },
    {
      "pattern": "/.github/workflows/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "security-reviewer"]
    },
    {
      "pattern": "/.changeset/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "release-manager"]
    }
  ],
  "stageLifecycle": {
    "statuses": ["not-started", "in-progress", "complete", "blocked"],
    "terminalStatuses": ["complete", "blocked"],
    "allowedTransitions": [
      ["not-started", "in-progress"],
      ["in-progress", "complete"],
      ["in-progress", "blocked"],
      ["blocked", "in-progress"]
    ],
    "completionEvidence": [
      "Outcome",
      "Delivered scope",
      "Contracts and files",
      "Validation",
      "Enterprise applicability",
      "Boundary audit"
    ]
  }
}
