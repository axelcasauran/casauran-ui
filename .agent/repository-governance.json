      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/registry/themes/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/registry/accessibility/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/registry/react-state/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/registry/collections/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer"]
    },
    {
      "pattern": "/registry/overlay/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "domain-owner", "evidence-reviewer", "security-reviewer"]
    },
    {
      "pattern": "/packages/tokens/**",
      "owners": ["@axelcasauran"],
