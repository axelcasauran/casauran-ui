    },
    {
      "pattern": "/playwright.config.ts",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "evidence-reviewer"]
    },
    {
      "pattern": "/vitest.config.mts",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "evidence-reviewer"]
    },
    {
      "pattern": "/package.json",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "evidence-reviewer"]
    },
    {
      "pattern": "/.agent/protocol.md",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "evidence-reviewer"]
    },
    {
      "pattern": "/.agent/prompts/**",
      "owners": ["@axelcasauran"],
      "roles": ["maintainer", "evidence-reviewer"]
    },
    {
      "pattern": "/.agent/workflows/**",
      "owners": ["@axelcasauran"],
