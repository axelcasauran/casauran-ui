{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casauran.dev/schemas/repository-governance.schema.json",
  "title": "Casauran repository governance contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "roles",
    "authority",
    "changeClasses",
    "pathOwnership",
    "stageLifecycle"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "defaultBranch", "maintainer"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "defaultBranch": { "type": "string", "minLength": 1 },
        "maintainer": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/role" }
    },
    "authority": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/authority" }
    },
    "changeClasses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/changeClass" }
    },
    "pathOwnership": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pathOwnership" }
    },
    "stageLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statuses", "terminalStatuses", "allowedTransitions", "completionEvidence"],
      "properties": {
        "statuses": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "terminalStatuses": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "allowedTransitions": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "type": "string" }],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "completionEvidence": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "holders", "accountabilities"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "holders": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" },
          "uniqueItems": true
        },
        "accountabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "id", "sources"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "changeClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workflow", "requiredRoles", "requiredEvidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "workflow": { "type": "string", "minLength": 1 },
        "requiredRoles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pathOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "owners", "roles"],
      "properties": {
        "pattern": { "type": "string", "minLength": 1 },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^@[A-Za-z0-9-]+$" },
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
