{
  "name": "@casauran/icons",
  "version": "0.0.0",
  "type": "module",
  "description": "supported tree-shakeable SVG icon data",
  "files": [
    "dist",
    "src/**/*.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.18.0 <27"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
