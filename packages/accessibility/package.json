{
  "name": "@casauran-internal/accessibility",
  "version": "0.0.0",
  "type": "module",
  "description": "focus, roving focus, live regions and keyboard primitives",
  "files": [
    "dist",
    "src/**/*.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./accessibility.css": "./src/accessibility.css",
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.18.0 <27"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": true
}
