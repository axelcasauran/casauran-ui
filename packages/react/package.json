{
  "name": "@casauran/react",
  "version": "0.0.0",
  "type": "module",
  "description": "supported React component surface",
  "files": [
    "dist",
    "src/**/*.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button.css": "./src/components/buttons/button/button.css",
    "./icon.css": "./src/components/icons/icon/icon.css",
    "./svg-icon.css": "./src/components/icons/svg-icon/svg-icon.css",
    "./typography.css": "./src/components/typography/typography/typography.css",
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.18.0 <27"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@casauran/icons": "workspace:*",
    "@casauran-internal/core": "workspace:*",
    "@casauran-internal/accessibility": "workspace:*",
    "@casauran-internal/events": "workspace:*",
    "@casauran-internal/collections": "workspace:*",
    "@casauran-internal/overlay": "workspace:*",
    "@casauran-internal/positioning": "workspace:*",
    "@casauran-internal/i18n": "workspace:*",
    "@casauran-internal/date-math": "workspace:*",
    "@casauran-internal/animation": "workspace:*"
  }
}
